---
/** Адаптивная картинка: /images/<name>.webp (1600) и <name>-800.webp. Пометка «визуализация» — честно о том, что это не фото объекта. */
interface Props { name: string; alt: string; ratio?: string; sizes?: string; eager?: boolean; zoom?: boolean; viz?: boolean; class?: string; reveal?: boolean; i?: number }
const { name, alt, ratio = '4 / 3', sizes = '(max-width: 760px) 100vw, 50vw', eager = false, zoom = false, viz = false, class: cls, reveal = false, i = 0 } = Astro.props;
---
<figure class:list={['pic', cls, { 'pic--zoom': zoom, 'reveal-img': reveal }]} style={`aspect-ratio:${ratio};--i:${i}`}>
  <img src={`/images/${name}.webp`} srcset={`/images/${name}-800.webp 800w, /images/${name}.webp 1600w`} sizes={sizes} alt={alt} width="1600" height="1200" loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : undefined} />
  {viz && <figcaption class="viz">визуализация</figcaption>}
</figure>
