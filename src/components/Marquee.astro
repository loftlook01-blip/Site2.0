---
interface Props { items: string[]; dark?: boolean }
const { items, dark = false } = Astro.props;
---
<div class:list={['mq', { dark }]} aria-hidden="true">
  <div class="mq-track">
    {[0, 1].map(() => <div class="mq-row">{items.map((t) => <span>{t}</span>)}</div>)}
  </div>
</div>
<style>
  .mq { overflow: hidden; padding-block: 22px; border-block: 1px solid var(--line); }
  .mq.dark { border-color: var(--line-dark); }
  .mq-track { display: flex; width: max-content; animation: mq 46s linear infinite; }
  .mq:hover .mq-track { animation-play-state: paused; }
  .mq-row { display: flex; }
  .mq-row span { display: inline-flex; align-items: center; gap: clamp(24px, 4vw, 56px); padding-right: clamp(24px, 4vw, 56px); font: 500 clamp(22px, 2.6vw, 38px)/1 var(--serif); letter-spacing: -0.01em; white-space: nowrap; }
  .mq-row span::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  @keyframes mq { to { transform: translateX(-50%); } }
</style>
