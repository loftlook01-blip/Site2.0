---
/** Мобильная панель связи + общие скрипты: появление блоков, цели Метрики, прогресс прокрутки для motion-секций */
import Icon from './Icon.astro';
import { SITE, messengers } from '../data/site';
const ms = messengers().slice(0, 1);
---
<div class="mbar" aria-label="Быстрая связь">
  <a href={`tel:${SITE.phoneHref}`} data-goal="call"><Icon name="phone" /><span>Позвонить</span></a>
  {ms.map((m) => <a href={m.href} target="_blank" rel="noopener" data-goal="messenger"><Icon name={m.id} /><span>{m.label}</span></a>)}
  <a href="/konstruktor/"><Icon name="cube" /><span>Расчёт</span></a>
  <button class="mbar-cta" data-lead="Мобильная панель"><Icon name="ruler" /><span>Замер</span></button>
</div>

<script>
  import { goal } from '../lib/lead-client';
  document.addEventListener('click', (e) => {
    const g = (e.target as HTMLElement).closest<HTMLElement>('[data-goal]');
    if (g) goal(g.dataset.goal!);
  });

  // Появление блоков
  const io = new IntersectionObserver((es) => es.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }), { rootMargin: '0px 0px -7% 0px' });
  document.querySelectorAll('.reveal, .reveal-img, .split').forEach((el) => io.observe(el));

  // Прогресс прокрутки: [data-scrub] получает --p от 0 до 1, [data-parallax] — --y
  const scrubs = [...document.querySelectorAll<HTMLElement>('[data-scrub]')];
  const pars = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if ((scrubs.length || pars.length) && !reduce) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = innerHeight;
      for (const el of scrubs) {
        const r = el.getBoundingClientRect();
        if (r.bottom < -vh || r.top > vh * 2) continue;
        const mode = el.dataset.scrub;
        const p = mode === 'view' ? (vh - r.top) / (vh + r.height) : -r.top / Math.max(1, r.height - vh);
        const c = Math.min(1, Math.max(0, p));
        el.style.setProperty('--p', c.toFixed(4));
        const n = Number(el.dataset.steps);
        if (n) { const st = String(Math.min(n - 1, Math.floor(c * n))); if (el.dataset.step !== st) el.dataset.step = st; }
      }
      for (const el of pars) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) continue;
        el.style.setProperty('--y', (((r.top + r.height / 2 - vh / 2) / vh) * Number(el.dataset.parallax || 40)).toFixed(1) + 'px');
      }
    };
    const on = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', on, { passive: true });
    addEventListener('resize', on, { passive: true });
    update();
  } else scrubs.forEach((el) => { el.style.setProperty('--p', '1'); if (el.dataset.steps) el.dataset.step = String(Number(el.dataset.steps) - 1); });
</script>

<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    .mbar { position: fixed; z-index: 40; left: 8px; right: 8px; bottom: calc(8px + env(safe-area-inset-bottom)); display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; padding: 5px; border-radius: 100px; background: rgb(21 22 20 / 0.88); color: var(--on-dark); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 12px 40px rgb(0 0 0 / 0.3); }
    .mbar a, .mbar button { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 46px; padding: 0 8px; border-radius: 100px; font-size: 13px; font-weight: 500; text-decoration: none; color: inherit; background: none; border: 0; }
    .mbar :global(svg) { width: 17px; height: 17px; }
    .mbar .mbar-cta { background: var(--accent); color: #fff; }
    :global(body) { padding-bottom: 72px; }
  }
  @media (max-width: 380px) { .mbar a span { display: none; } }
</style>
